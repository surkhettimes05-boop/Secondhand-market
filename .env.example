# Preview needs no external services. Live mode never falls back to sample inventory.
MARKET_MODE=preview
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER ONLY: processed media storage and expiry jobs; never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# At least 32 random characters.
CRON_SECRET=
# Optional public Turnstile site key; configure matching native CAPTCHA protection in Supabase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
